      "parameters": {
        "jsCode": "const input = $input.first().json.body;\n\nconst channel = input.channel || 'unknown';\nconst senderEmail = (input.sender_email || '').trim().toLowerCase();\nconst query = (input.query || '').trim();\n\nreturn {\n  channel: channel,\n  sender_email: senderEmail,\n  query: query\n};"
      },
