        "jsCode": "const items = $input.all();\nconst found = items.length > 0;\n\nreturn {\n  author_found: found,\n  author_data: found ? items[0].json : null,\n  channel: $('Parse Input').first().json.channel,\n  sender_email: $('Parse Input').first().json.sender_email,\n  query: $('Parse Input').first().json.query\n};"
